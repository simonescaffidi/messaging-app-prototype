# Securmy - server (server.js). Copia in .env per lo sviluppo locale; in produzione le variabili sono su Railway.
# Nessun valore reale in questo file.

PORT=3000
# PostgreSQL (Railway). Senza DATABASE_URL in locale usa il file data.json.
DATABASE_URL=
# URL pubblico per i link nelle email (default: RAILWAY_PUBLIC_DOMAIN o localhost)
APP_BASE_URL=

# Cifratura dati a riposo (email/username) e pepper dei codici: NON cambiarli in produzione
DATA_KEY=
CODE_PEPPER=
SESSION_SECRET=

# Email (stack-standard): API Brevo
BREVO_API_KEY=
MAIL_FROM_EMAIL=info@simonescaffidi.it
MAIL_FROM_NAME=Securmy
# Fallback temporaneo: usato solo se BREVO_API_KEY e' vuota
RESEND_API_KEY=
# Mittente storico per Resend, formato "Nome <email>"
EMAIL_FROM=

# Alert errori (crash, 5xx, DB giu', email fallite)
ALERT_EMAIL=info@simonescaffidi.it
# Prova: GET /health/test-alert?token=ALERT_TEST_TOKEN
ALERT_TEST_TOKEN=

# Sync a pagamento (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# centesimi/mese per 5, 25, 100 GB
SYNC_PRICES=199,499,1499

# TURN gestito (uno dei due) oppure coturn proprio
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
METERED_APP=
METERED_API_KEY=
TURN_URL=
TURN_USER=
TURN_PASS=
TURN_SECRET=
TURN_RELAY_ONLY=

# Link di download Android (redirect stabile)
ANDROID_APK_URL=
