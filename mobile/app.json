{
  "expo": {
    "name": "Securmy",
    "slug": "securmy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0f1115"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "it.simonescaffidi.securmy",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usa Face ID per sbloccare rapidamente i tuoi profili di Securmy.",
        "NSCameraUsageDescription": "La fotocamera serve per le videochiamate cifrate e per scegliere foto da proteggere.",
        "NSMicrophoneUsageDescription": "Il microfono serve per le chiamate cifrate.",
        "NSPhotoLibraryUsageDescription": "Serve per aggiungere foto e file alla tua cassaforte.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": true
      }
    },
    "android": {
      "package": "it.simonescaffidi.securmy",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "BLUETOOTH",
        "BLUETOOTH_CONNECT",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f1115"
      },
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#6d7cff"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "13.4"
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "La fotocamera serve per le videochiamate cifrate.",
          "microphonePermission": "Il microfono serve per le chiamate cifrate."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Serve per aggiungere foto alla tua cassaforte."
        }
      ]
    ],
    "scheme": "securmy"
  }
}